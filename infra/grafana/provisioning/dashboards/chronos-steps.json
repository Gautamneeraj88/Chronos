{
  "id": null,
  "uid": "chronos-steps",
  "title": "Chronos — Step Performance",
  "tags": ["chronos"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Step p95 Duration by Activity",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (activityName, le) (rate(chronos_step_duration_ms_bucket[5m])))",
          "legendFormat": "{{activityName}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "continuous-GrYlRd" }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Step Failure Rate by Activity",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(chronos_worker_step_attempts_total{success=\"false\"}[5m])",
          "legendFormat": "{{activityName}} failures/s",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Step Attempt Rate by Activity",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(chronos_worker_step_attempts_total[5m])",
          "legendFormat": "{{activityName}} (success={{success}})",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Step p50 / p99 Latency",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (activityName, le) (rate(chronos_step_duration_ms_bucket[5m])))",
          "legendFormat": "p50 {{activityName}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (activityName, le) (rate(chronos_step_duration_ms_bucket[5m])))",
          "legendFormat": "p99 {{activityName}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    }
  ]
}
