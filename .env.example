# Chronos configuration
# Development: copy to .env and adjust values
# Production:  cp .env.example .env  then edit before docker compose up

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be at least 32 characters — Chronos refuses to start without it.
JWT_SECRET=

# ── Passwords (change all of these in production) ─────────────────────────────
# Generate with: openssl rand -hex 16
MONGO_USERNAME=chronos
MONGO_PASSWORD=changeme
REDIS_PASSWORD=changeme
RABBITMQ_USER=chronos
RABBITMQ_PASSWORD=changeme
RABBITMQ_ERLANG_COOKIE=chronos-secret-cookie
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
GRAFANA_ADMIN_PASSWORD=changeme

# ── Bootstrap first admin user ────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@chronos.dev
BOOTSTRAP_ADMIN_PASSWORD=changeme
BOOTSTRAP_ORG_ID=my-org

# ── Ports (optional — defaults shown) ────────────────────────────────────────
GATEWAY_PORT=3000
ORCHESTRATOR_PORT=3001
WORKER_PORT=3002
NOTIFIER_PORT=3003
GRAFANA_PORT=3004
DASHBOARD_PORT=8080

# ── Version (optional — defaults to latest) ───────────────────────────────────
CHRONOS_VERSION=latest

# ── Dev-only vars (not used by docker-compose.prod.yml) ──────────────────────
# These are needed when running services locally with pnpm dev
ORCHESTRATOR_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:5173
MONGODB_URI=mongodb://chronos:changeme@localhost:27017/chronos?authSource=admin
REDIS_URL=redis://:changeme@localhost:6379
KAFKA_BROKERS=localhost:9092
NEO4J_URI=bolt://localhost:7687
LOKI_URL=http://localhost:3100
NODE_ENV=development
LOG_LEVEL=debug

# Dashboard Vite env vars — copy to packages/dashboard/.env for local dev
VITE_API_URL=http://localhost:3000
VITE_GRAFANA_URL=http://localhost:3004
VITE_JAEGER_URL=http://localhost:16686
